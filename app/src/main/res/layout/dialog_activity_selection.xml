<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="选择注入的Activity"
        android:textColor="@color/text_color_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 搜索框 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:background="@drawable/edittext_background"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="@color/text_color_hint" />

        <EditText
            android:id="@+id/et_search_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:drawableEnd="@android:drawable/ic_menu_close_clear_cancel"
            android:hint="搜索Activity..."
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:textColor="@color/text_color_dark"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="请选择要注入代码的Activity："
        android:textColor="@color/text_color_hint"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/lv_activities_dialog"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/list_background"
        android:choiceMode="singleChoice"
        android:divider="@color/divider_color"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btn_confirm_activity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_primary_background"
        android:text="确认选择"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="15sp" />

</LinearLayout>
